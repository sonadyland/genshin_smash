# auto: complete OSS settings => signed; none => local; partial => startup error.
# local / direct / signed can also be selected explicitly.
GAME_ART_MODE=auto
# Public direct/CDN origin only for direct mode. Ignored in signed mode.
GAME_ASSET_BASE_URL=

# Server/upload tooling only. Never included in frontend builds or game container.
OSS_BUCKET=
OSS_REGION=
# Public service endpoint, e.g. https://oss-cn-hangzhou.aliyuncs.com (no bucket).
OSS_ENDPOINT=
OSS_ART_PREFIX=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# Signed URLs refresh together two minutes before expiry (300..86400 seconds).
OSS_SIGNED_URL_TTL_SECONDS=3600
# virtual for public OSS endpoint; cname for a custom bound HTTPS domain.
OSS_ADDRESSING_STYLE=virtual
